[node name="BackBtn" type="Button" parent="VBox"]
layout_mode = 2
text = "Back"

[connection signal="pressed" from="VBox/ApplyBtn" to="." method="_on_apply_pressed"]
[connection signal="pressed" from="VBox/BackBtn" to="." method="_on_back_pressed"]
